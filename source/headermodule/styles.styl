// header styles
#header
    background-color cd-dark-blue
    color #fff
    padding 15px
    width 100%
    box-sizing: border-box
    position fixed
    z-index 3
    box-shadow 0 0 5px alpha(#fff, 0.2)

    display flex
    justify-content: flex-start
    align-items: center
    gap 10px

    h1
        font-size 18pt
        overflow: hidden
        text-overflow: ellipsis
        white-space: nowrap
        span
            font-size 12pt

#header-logo
    width: 45px
    height 45px
    color cd-light-blue
    img
        width inherit
        height inherit

#beta-banner
    display none
    background-color rgba(255, 165, 0, 0.15)
    color #ffa500
    border-left 3px solid #ffa500
    border-radius: 3px
    padding 5px 10px
    text-align: left
    max-width 705px
    h2
        font-size: 12pt
        margin-bottom 3px
    p
        font-size 11pt

    a
        color #fff
        font-size 11pt
        text-decoration none
        &:hover
            text-decoration underline

#logout-button
    display none
    margin-left auto
    width 33px
    min-width 33px
    height 33px
    svg
        color #c21
        vertical-align: middle
        width: inherit
        height inherit

.logged-in
    #logout-button
        display block

@media desktopscreen
    #header-logo
        width: 60px
        height 60px
        img
            height inherit
            width inherit
            
    #logout-button
        width 42px
        min-width 42px
        height 42px


    #header
        padding 20px
        gap 20px

        h1
            font-size 25pt
            line-height: 60px

    #beta-banner
        display block
        font-size 13pt
        padding 6px 16px
