#seasonality-blocks
    position absolute
    top 500px
    left 0
    height 260px
    width 100%
    box-sizing: border-box
    padding 0 15px 10px 15px
    display flex
    flex-direction column
    // opacity instead of display: the chart is rendered while hidden (loading) and needs its size
    opacity 0
    pointer-events: none

#seasonality-blocks-chart
    flex 1 1 0
    min-height 0
    width 100%

// mirrored #backtesting-details-tabs: line on top, the tabs hang below the chart
#seasonality-blocks-tabs
    display flex
    gap 5px
    border-top solid 1px alpha(#fff, 0.2)
    button
    button:hover // reset.styl clears padding on button:hover
        padding 8px 15px
        font-size 11pt
        color alpha(#fff, 0.6)
        border-top solid 2px transparent
    button.active
        color #fff
        border-top-color #fff
    button[hidden]
        display none
