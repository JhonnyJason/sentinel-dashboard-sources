// globalstyles styles

/*==========================================================
Color Theme
==========================================================*/
cd-foreground = black
cd-flash = purple
cd-background = white

// cd-error-red = #711
cd-error-red = rgb(213, 56, 56)
// cd-good-green = #383
cd-good-green = rgb(68, 151, 68)

// cd-danger-red = #9B1313
cd-danger-red = #bB3333

cd-info = #517891
cd-dark-blue = #113
cd-light-blue = #0ac

cd-button-dark = #113

cd-down-red = #ff6464
cd-up-green = #4caf50

cd-flash-orange = #ffa500
cd-orangy-transparancy = rgba(255, 165, 0, 0.15)
/*==========================================================
Global Variables
==========================================================*/
// max-content-width = 900px
// mobile-side-padding = 15px

side-nav-width = 250px

header-height = 106px
mobile-header-height = 75px

mobileMaxWidth = 1333px
miniscreenWidth = 335px

desktopscreen = 'screen and (min-width: %s)' %  mobileMaxWidth
miniscreen = 'screen and (max-width: %s)' % miniscreenWidth

/*==========================================================
General Tag Styles
==========================================================*/
body
    background-color cd-background
    color cd-foreground
    font-family: Arial, Helvetica, sans-serif
    text-align: center
    font-size: 12pt
    width 100%
    line-height: 125%

h1
    font-size: 21pt
h2
    font-size: 15pt
h3
    font-size: 14pt
p
    font-size: 12pt

svg
    width inherit
    height inherit


.hidden-template
.hidden-templates
    display none
/*==========================================================
Standard Button - use with .click-button for regular text buttons
==========================================================*/
.standard-button
.standard-button:hover // reset.styl strips button:hover (higher specificity than a bare class)
    font-size 12pt
    color #fff
    background-color cd-button-dark
    box-sizing border-box
    border solid 2px #fff
    box-shadow 0 0 5px #000
    padding 12px 20px
    border-radius 10px

/*==========================================================
Select - wrap a select in .select-wrapper: dropdown arrow + field style
==========================================================*/
.select-wrapper
    display block
    position relative

.select-wrapper::after
    content ""
    display block
    position absolute
    top 50%
    right 9px
    z-index 200
    width 12px
    height 8px
    transform translateY(-4px)
    background-color cd-dark-blue
    clip-path polygon(100% 0%, 0 0%, 50% 100%)

.select-wrapper select
.select-wrapper select:focus // reset.styl strips select:focus (same specificity as a bare element)
    z-index 1
    padding 10px
    padding-right 25px
    border-radius 3px
    border solid 1px cd-dark-blue
    font-size 12pt
    background #fff
    cursor pointer
    transition box-shadow 0.2s
    appearance none

.select-wrapper select:focus
    outline none
    box-shadow 0 0 3px 0 cd-dark-blue
