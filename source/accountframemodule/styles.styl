@import 'visibility.styl'

// accountframe styles
#accountframe
    width 100%
    text-align left
    padding 25px
    // padding-left 50px
    box-sizing: border-box
    max-width: 600px

    .click-button
        display block
        width 100%
        font-size 12pt
        color #fff
        // background-color #000
        background-color cd-button-dark
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 12px 20px
        border-radius: 10px

#top-line
    display flex
    flex-wrap: wrap
    justify-content: space-between
    align-items: center
    gap 20px
    h1
        flex 0 0 auto

#coupon-element
    flex 0 1 auto 
    padding 10px 40px
    align-items: center
    gap 20px
    // background-color alpha(cd-flash-orange, 0.2)
    background-color alpha(#ccc, 0.2)
    border-radius: 3px 
    margin-left auto

#coupon-display
    font-weight: bold
    font-size: 16pt

#account-status
    margin-top 50px

    .status-info
        text-align: left
        // margin 30px
        padding 10px 15px
        background-color alpha(cd-light-blue, 0.15)
        border-left 3px solid cd-light-blue
        border-radius: 3px
        font-size 0.9em
        margin-bottom 10px


    .warning
        text-align: left
        // margin 30px
        padding 10px 15px
        background-color rgba(255, 100, 100, 0.15)
        border-left 3px solid cd-down-red
        border-radius: 3px
        font-size 0.9em
        margin-bottom 10px

#account-status-tester
#account-status-free-access
#account-status-unlimited-access
#account-status-limited-access
    // width 200px
    color white
    text-align: center
    padding 12px 0
    border-radius 3px
    margin 20px 0

#account-status-limited-access
    background-color #c21
#account-status-tester
#account-status-free-access
#account-status-unlimited-access
    background-color #1b2

#paid-access-end
#free-access-end
    font-weight: bold

#autorenew-management
    // margin 30px
    margin-top 30px
    // margin-right 30px
    #cancel-subscription-button
        background-color #812

#abonnement-orders
    margin 120px 30px
    text-align: center
    
    .promotion-display
        display: flex
        justify-content: stretch
        padding 0 30px
        align-items: center
        width 100%
        box-sizing: border-box
        // flex-wrap: wrap

    .promotion-price-original
        flex 1 1 auto
        font-size: 32pt
        background-color alpha(#c21, 0.1)
        // width 100%
        // height 100%
        padding 30px 20px
        position: relative
        border-left solid 5px alpha(#c21, 0.7)
        border-radius 3px 0 0 3px

        span:after
            content "€"
            font-size: 20pt
            margin-left 2px
            text-decoration: none            

        span:before
            content ""
            position absolute
            width 66%
            height 5px
            background-color: alpha(#c21, 0.7) 
            top 50%
            left 50%
            transform translate(-50%, -50%) rotate(-19deg)
            border-radius: 3px 0 3px 0

    .promotion-price-discount
        flex 1 1 auto
        font-size: 32pt
        background-color alpha(#1b2, 0.06)
        // width 100%
        // height 100%
        padding 30px 20px
        border-right solid 5px alpha(#1b2, 0.7)
        border-radius 0 3px 3px 0
        span:after
            content "€"
            font-size: 20pt
            margin-left 2px

    .promotion-discount
        display: block
        box-shadow: 0 0 7px #999
        border-radius: 3px
        max-width 140px
        // flex-direction: column
        // gap 10px
        // align-items: center

    .discount-amount
        font-size 27pt
        background-color cd-flash-orange
        width 100%
        padding 20px
        box-sizing: border-box

    .discount-amount:after
        content "%"
        font-size: 16pt
        margin-left 2px

    .discount-amount:before
        content "-"
        margin-right 2px

    .discount-badge 
        padding 10px
        // background-color alpha(#ccc, 0.2)    
        width 100%
        box-sizing: border-box
        font-size 16pt
        font-weight: bold

    .discount-title
        padding 10px
        // background-color alpha(#ccc, 0.2) 

    h2
        border-top solid 2px #ccc
        padding-top 30px
        margin-top 90px
        margin-bottom 30px
        // text-align: left
        font-size: 19pt
        // font-weight: bold
    .click-button
        margin-bottom 60px
        margin-top 30px


#abonnement-orders.no-discount
    .promotion-price-discount
        border-left solid 5px alpha(#1b2, 0.7)
        border-radius 3px

#account-management
    margin 120px 10px
    
    h2
        margin 30px 0

    #email-section
        min-height: 300px
    #password-section
        min-height: 400px

    #deletion-preloader
    #email-change-preloader
    #password-change-preloader    
        flex 0 0 auto
        display none
        height 25px
        width 25px


    .feedback-line
        display flex
        flex-direction: row
        justify-content: space-between
        align-items: center
        padding 0 10px
        gap 10px
        p
            display none
            margin 0
            font-size: 10pt
            color #934
    
    .feedback
        .feedback-line
            p
                display block
    
    .pending
        #deletion-preloader
        #email-change-preloader
        #password-change-preloader    
            display block

    .change-block
        // border-top solid 5px cd-dark-blue
        // border-bottom solid 5px cd-dark-blue
        margin-top 30px
        background-color alpha(#999, 0.05)
        padding 20px
        box-sizing: border-box
        border-radius: 5px

    input
        display: block
        font-size 12pt
        width 100%
        box-sizing: border-box
        padding: 10px 
        border none
        outline: none
        margin-bottom 20px
        border-bottom solid 1px transparent

    input:focus
        border-bottom solid 1px cd-dark-blue

    label
        display block
        margin-bottom 5px
    button
        margin-bottom 10px

    .button-block
        margin-bottom 60px
    p
        margin 20px 0
        // color #444
    .virgin
        button
            opacity 0.4
            pointer-events: none

    #deletion-block
        margin-top 120px

    #deletion-button
        background-color #812
        margin-bottom 10px
    #deletion-hint
        color #812
        margin 0 15px

    .locked
        .change-block
            display none
        #deletion-button
            background-color #301
        #deletion-hint
            display none

@media screen and (max-width: 540px)
    #abonnement-orders
        .promotion-display
            flex-direction: column
        .promotion-display > *
            width 100%
            max-width 100%

@media screen and (max-width: 601px)
    #accountframe
        padding 60px 5px 20px 0px
    