// partnersframe styles
#partnersframe
    width 100%
    padding 25px
    text-align: left

    h1
        margin-bottom 50px

    .partner-entry
        margin-bottom 70px
    .black
        background-color #000
    .logo
        padding 20px
        width fit-content

    .description
        padding 20px
        max-width: 600px
        box-sizing: border-box

    .special-offer
    .website
        padding 0 20px
    
        h3
            color #888
            font-size 11pt
            margin-bottom 5px 
        a
            display block
            font-size 16pt
            margin-bottom 20px
            text-decoration: underline